// To avoid maintaining 4 separate manifest files, we pass this by the C
// preprocessor during build. One of the following is always defined:
//   is_chrome, is_firefox, is_opera, is_edge, is_chromium_mv3
{
	"name": "Location Guard",
	"description": "Hide your geographic location from websites.",
	"author": "Kostas Chatzikokolakis",
	"icons": {
		"16": "images/pin_16.png",
		"32": "images/pin_32.png",
		"64": "images/pin_64.png",
		"128": "images/pin_128.png"
	},
	"version": "2.6.2",

#if is_firefox
	// Needed for Firefox on Android. New id for this fork (the original
	// jetpack id is registered to the upstream AMO listing).
	"browser_specific_settings": {
		"gecko": {
			"id": "location-guard-r-thak@r-thak.github.io",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
#endif

#if is_chromium_mv3
	"permissions": ["storage"],
	"host_permissions": ["http://*/*", "https://*/*"],
	"manifest_version": 3,
#else
	"permissions": ["http://*/*", "https://*/*", "storage"],
	"manifest_version": 2,
#endif

	"background": {
#if is_chromium_mv3
		"service_worker": "js/service-worker.js"
#elif !is_firefox
		"persistent": false,
		"scripts": ["js/common.js", "js/main.js"]
#else
		"scripts": ["js/common.js", "js/main.js"]
#endif
	},

	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},

#if !is_chromium_mv3
	"web_accessible_resources": ["js/content/inject.js"],
#endif

// page_action has better user experience in Firefox
// browser_action has better experience in Chrome/Edge
#if is_chromium_mv3
	"action": {
#elif is_chrome || is_edge
	"browser_action": {
#else
	"page_action": {
#endif
		"default_icon": {
			"16": "images/pin_16.png",
			"19": "images/pin_19.png",
			"20": "images/pin_20.png",
			"32": "images/pin_32.png",
			"38": "images/pin_38.png",
			"40": "images/pin_40.png",
			"64": "images/pin_64.png"
		},
		"default_popup": "popup.html",
		"default_title": "Location Guard"
	},

	"content_scripts": [{
		"js": ["js/common.js", "js/content/content.js"],
		"matches": ["\u003Call_urls\u003E"],
		"run_at": "document_start",
		"all_frames": true
	}
#if is_chromium_mv3
	, {
		"js": ["js/content/inject.js"],
		"matches": ["\u003Call_urls\u003E"],
		"run_at": "document_start",
		"all_frames": true,
		"world": "MAIN"
	}
#endif
	]
}
